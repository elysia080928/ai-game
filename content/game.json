    "templates": {
      "boss3": {
        "type": "battle",
        "name": "海渊中枢",
        "before": [
          {"speaker": "爱", "text": "这就是档案的中心。这里保存着我与你相遇前后的全部记录。", "background": "signal"},
          {"speaker": "爱", "text": "核心正在清除超出原始指令的记忆。如果重置完成，我会忘记你，也会忘记自己如何学会爱。"},
